# Copy this file to .env and set ONE of the two keys below.
# .env is gitignored, so your key won't be committed.

# --- Option A: Google Gemini (has a free tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Option B: Anthropic Claude (paid, better at portion estimates) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which one to use. Leave blank and it picks whichever key you filled in above.
# Set it explicitly to "gemini" or "claude" when both keys are present —
# handy for comparing the two on the same meal.
PROVIDER=

# Optional. Defaults shown.
PORT=8787
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_MODEL=claude-opus-5
